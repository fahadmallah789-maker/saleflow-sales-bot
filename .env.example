# Copy this file to .env for local use and change the values.
# NEVER commit your real .env file to GitHub.

# Initial admin account (created on first start if no users exist)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password

# Server
PORT=3000
NODE_ENV=development

# SQLite database file (created automatically)
DATABASE_PATH=./data/saleflow.db

# Long random string used to sign session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace_with_a_long_random_string

# Set to true when the site is served over HTTPS (production)
COOKIE_SECURE=false

# Set to true when running behind a proxy such as Render, Railway or Fly.io
TRUST_PROXY=false
